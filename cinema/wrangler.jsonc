{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cung-xem-cinema-alpha",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory":"./dist", "binding":"ASSETS", "not_found_handling":"single-page-application", "run_worker_first":["/api/*"]},
  "durable_objects": {"bindings":[{"name":"ROOMS","class_name":"RoomSlot"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["RoomSlot"]}],
  "observability":{"enabled":true,"head_sampling_rate":0.1}
}
